{
  "name": "pocket-ledger",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Offline-first two-currency spending tracker for iPhone (web app) and Android.",
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/prepare-web.js && expo start --web",
    "build:web": "node scripts/prepare-web.js && expo export --platform web && node scripts/build-pwa.js",
    "preview:web": "node scripts/serve-web.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "sql.js": "^1.15.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-doctor": "^1.21.5",
    "fake-indexeddb": "^6.2.7",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  }
}
